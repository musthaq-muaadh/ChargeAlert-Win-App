<Window x:Class="ChargeAlert.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ChargeAlert" Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Opacity="0">

    <Window.Resources>
        <Style x:Key="PopBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="14,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Card" Margin="20" CornerRadius="20" Background="#FF121212"
            BorderBrush="#33FFFFFF" BorderThickness="1" Padding="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="0"/>
        </Border.RenderTransform>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="IconCircle" Width="46" Height="46" CornerRadius="23" VerticalAlignment="Top">
                <TextBlock x:Name="IconText" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="MessageText" Foreground="#A8A8A8" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                <ProgressBar x:Name="LevelBar" Maximum="100" Height="5" Margin="0,12,0,0"
                             Background="#2A2A2A" BorderThickness="0"/>
                <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="SnoozeBtn" Style="{StaticResource PopBtn}" Content="Snooze 10 min" Click="Snooze_Click"/>
                    <Button x:Name="DismissBtn" Style="{StaticResource PopBtn}" Content="Dismiss" Background="#3A3A3A" Click="Dismiss_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
